# TTA CLAUDE — sayt sozlamalari (.env). Maxfiy qiymatlarni faqat shu faylda saqlang.

# Anthropic API kaliti (console.anthropic.com → API keys). Bo'sh qoldirsangiz admin panelidan kiritasiz.
ANTHROPIC_API_KEY=

# Birinchi admin: login va parol (parol bo'sh bo'lsa tasodifiy yaratilib data/ADMIN_PAROL.txt ga yoziladi)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=

# Sayt manzili yo'li: Caddy orqali https://bepulkurs.uz/claude/ bo'lsa BASE_PATH=/claude; subdomen bo'lsa bo'sh
BASE_PATH=/claude
PUBLIC_URL=https://bepulkurs.uz/claude/
# HTTPS orqali ishlasa cookie'larni faqat HTTPS bilan yuboradi
COOKIE_SECURE=1

# Konteyner porti (faqat 127.0.0.1 ga ochiladi, Caddy ulanadi)
PORT=8095

# Standart model: fable | opus | sonnet | haiku (yoki to'liq model ID)
DEFAULT_MODEL=sonnet
# Standart ruxsat rejimi: auto | acceptEdits | default | plan
DEFAULT_MODE=auto
# bypassPermissions rejimiga admin uchun ruxsat (1/0)
ALLOW_BYPASS=1

# API kalitni agent subprotsessidan yashirish (lokal proksi). 1 — tavsiya etiladi
HIDE_API_KEY=1
# Faol bo'lmagan sessiya jarayonini necha daqiqadan keyin yopish
IDLE_CLOSE_MINUTES=20
# Yuklanadigan fayl hajmi chegarasi (MB)
MAX_UPLOAD_MB=200
TZ=Asia/Tashkent
